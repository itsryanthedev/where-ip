{
  "name": "where-ip",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "packageManager": "pnpm@11.10.0",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.8",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.9",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "secrets:check": "node ./scripts/check-secrets.mjs",
    "secrets:check:history": "node ./scripts/check-secrets.mjs --history",
    "assets:generate": "node ./scripts/generate-assets.mjs",
    "export:web": "expo export --platform web",
    "export:web:pages": "EXPO_WEB_BASE_URL=/where-ip expo export --platform web --output-dir dist-pages",
    "export:desktop": "EXPO_WEB_BASE_URL=/ expo export --platform web --output-dir dist-desktop",
    "electron:start": "pnpm run export:desktop && electron electron/main/index.cjs",
    "electron:package": "pnpm run export:desktop && electron-forge package",
    "electron:test": "node --test electron/tests/*.test.cjs",
    "verify": "pnpm run secrets:check && pnpm run lint && pnpm run typecheck && pnpm test && pnpm run export:web"
  },

  "private": false,
  "license": "Apache-2.0",
  "config": {
    "forge": "./electron-forge.config.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsryanthedev/where-ip.git"
  },
  "bugs": {
    "url": "https://github.com/itsryanthedev/where-ip/issues"
  },
  "homepage": "https://github.com/itsryanthedev/where-ip#readme",
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "src/services/**/*.ts",
      "src/utils/**/*.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
