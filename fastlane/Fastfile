# frozen_string_literal: true

require "json"

default_platform(:android)

platform :android do
  desc "Validate Play API access + metadata (no uploads)"
  lane :play_validate do
    supply(
      package_name: CredentialsManager::AppfileConfig.try_fetch_value(:package_name),
      json_key: CredentialsManager::AppfileConfig.try_fetch_value(:json_key_file),
      validate_only: true,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload Play Store listing metadata (text only; no binary/images)
  Note: classic `supply` needs an existing track release (AAB). Before the first
  binary, use the Play Developer API listing edit (or Console) for text/icon."
  lane :play_metadata do
    supply(
      package_name: CredentialsManager::AppfileConfig.try_fetch_value(:package_name),
      json_key: CredentialsManager::AppfileConfig.try_fetch_value(:json_key_file),
      track: "internal",
      release_status: "draft",
      changes_not_sent_for_review: true,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      metadata_path: "fastlane/metadata/android"
    )
  end

  desc "Upload Play Store listing metadata + graphics (icon, feature graphic, screenshots)
  Does not submit for review. Requires an existing track release (e.g. internal AAB)."
  lane :play_listing do
    supply(
      package_name: CredentialsManager::AppfileConfig.try_fetch_value(:package_name),
      json_key: CredentialsManager::AppfileConfig.try_fetch_value(:json_key_file),
      track: "internal",
      release_status: "draft",
      changes_not_sent_for_review: true,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      metadata_path: "fastlane/metadata/android"
    )
  end
end

platform :ios do
  desc "Upload App Store Connect metadata and screenshots without submitting for review"
  lane :app_store_metadata do
    # Fastlane 2.237.0 attempts to fetch an optional review attachment even
    # when none is configured. App Store Connect returns an empty response for
    # this new version, so skip only that optional step and keep all metadata
    # and screenshot uploads enabled.
    require "deliver/upload_metadata"
    Deliver::UploadMetadata.class_eval do
      def review_attachment_file(_version)
        UI.message("No App Review attachment configured; skipping attachment upload")
      end
    end

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      duration: 1_200,
      in_house: false
    )

    deliver(
      api_key: api_key,
      app_identifier: "com.elmowjastudio.whereip",
      app_version: JSON.parse(File.read("../package.json"))["version"],
      metadata_path: "fastlane/metadata/ios",
      screenshots_path: "fastlane/screenshots",
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      app_rating_config_path: File.expand_path("metadata/ios/age_rating.json"),
      force: true
    )
  end

end
